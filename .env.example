# Bot settings
BOT_TOKEN=your_bot_token
ADMIN_USER_ID=123456789
# Optional legacy fallback. Recommended to configure in admin panel instead.
MONITOR_CHAT_ID=

# Go version
MONITOR_CHAT_IDS=
ALERT_CHAT_ID=
KEYWORDS_FILE=configs/keywords.example.json
RECORDS_FILE=data/records.json
SETTINGS_FILE=data/settings.json
DM_TEMPLATE=你好，看到你刚刚在 {chat_title} 提到 {keywords}，如果你愿意的话可以继续聊聊。
COOLDOWN_MINUTES=1440
QUEUE_SIZE=100
POLL_TIMEOUT=30
DRY_RUN=false
LOG_LEVEL=info
