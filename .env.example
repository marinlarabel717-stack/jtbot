# Telegram user account
APP_ID=123456
APP_HASH=your_app_hash
PHONE=+10000000000
SESSION_FILE=data/session.json

# Admin bot backend (optional but recommended for inline button control)
BOT_TOKEN=
ADMIN_USER_ID=

# Monitoring
MONITOR_CHAT_IDS=
ALERT_CHAT_ID=
KEYWORDS_FILE=configs/keywords.example.json
RECORDS_FILE=data/records.json
SETTINGS_FILE=data/settings.json
BLACKLIST_FILE=data/blacklist.json
DM_TEMPLATE=你好，看到你刚刚在 {chat_title} 提到 {keywords}，如果你愿意的话可以继续聊聊。
COOLDOWN_MINUTES=1440
QUEUE_SIZE=100
POLL_TIMEOUT=30
DRY_RUN=false
LOG_LEVEL=info
